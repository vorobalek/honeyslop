@page "/clients"
@model ClientsModel
@{
    ViewData["Title"] = "Clients";
}

<form class="filters" method="get" data-auto-filter>
    <label>
        Seen within
        <select name="Days">
            <option value="1" selected="@(Model.Days == 1)">24 hours</option>
            <option value="7" selected="@(Model.Days == 7)">7 days</option>
            <option value="30" selected="@(Model.Days == 30)">30 days</option>
            <option value="0" selected="@(Model.Days <= 0)">all history</option>
        </select>
    </label>
</form>

<div class="actions">
    <span class="count">@Model.TotalCount clients, most recent first</span>
</div>

<div class="table-scroll">
<table class="entries">
    <thead>
    <tr>
        <partial name="_SortHeader" model='Model.Header(ClientColumn.Client, "Client")'/>
        <partial name="_SortHeader" model='Model.Header(ClientColumn.Requests, "Requests", "number")'/>
        <partial name="_SortHeader" model='Model.Header(ClientColumn.Hosts, "Hosts", "number")'/>
        <partial name="_SortHeader" model='Model.Header(ClientColumn.Paths, "Paths", "number")'/>
        <partial name="_SortHeader" model='Model.Header(ClientColumn.FirstSeen, "First seen")'/>
        <partial name="_SortHeader" model='Model.Header(ClientColumn.LastSeen, "Last seen")'/>
        <partial name="_SortHeader" model='Model.Header(ClientColumn.UserAgent, "Last User-Agent")'/>
    </tr>
    </thead>
    <tbody>
    @foreach (var client in Model.Clients)
    {
        <tr>
            <td class="mono"><partial name="_ClientIp" model="client.ClientIp"/></td>
            <td class="number">@client.Requests</td>
            <td class="number">@client.Hosts</td>
            <td class="number">@client.Targets</td>
            <td class="time">@client.FirstSeenAt.Display</td>
            <td class="time">@client.LastSeenAt.Display</td>
            <td class="agent">@client.LastUserAgent</td>
        </tr>
    }
    @if (Model.Clients.Length == 0)
    {
        <tr>
            <td colspan="7" class="empty">No clients in this period.</td>
        </tr>
    }
    </tbody>
</table>
</div>

<nav class="pager">
    @if (Model.PageNumber > 0)
    {
        <a asp-page="/Clients" asp-all-route-data="Model.RouteValues(Model.PageNumber - 1)">@(Model.IsSorted ? "← Previous" : "← More recent")</a>
    }
    <span>Page @(Model.PageNumber + 1) of @Model.PageCount</span>
    @if (Model.PageNumber + 1 < Model.PageCount)
    {
        <a asp-page="/Clients" asp-all-route-data="Model.RouteValues(Model.PageNumber + 1)">@Model.NextLabel</a>
    }
</nav>
