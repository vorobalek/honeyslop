@page "/clients"
@model ClientsModel
@{
    ViewData["Title"] = "Clients";
}

<form class="filters" method="get" data-auto-filter>
    <label>
        Seen within
        <select name="Days">
            <option value="1" selected="@(Model.Days == 1)">24 hours</option>
            <option value="7" selected="@(Model.Days == 7)">7 days</option>
            <option value="30" selected="@(Model.Days == 30)">30 days</option>
            <option value="0" selected="@(Model.Days <= 0)">all history</option>
        </select>
    </label>
</form>

<div class="actions">
    <span class="count">@Model.TotalCount clients, most recent first</span>
</div>

<div class="table-scroll">
<table class="entries">
    <thead>
    <tr>
        <th>Client</th>
        <th class="number">Requests</th>
        <th class="number">Hosts</th>
        <th class="number">Paths</th>
        <th>First seen</th>
        <th>Last seen</th>
        <th>Last User-Agent</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var client in Model.Clients)
    {
        <tr>
            <td class="mono"><a asp-page="/Requests" asp-route-ClientIp="@client.ClientIp">@client.ClientIp</a></td>
            <td class="number">@client.Requests</td>
            <td class="number">@client.Hosts</td>
            <td class="number">@client.Targets</td>
            <td class="time">@client.FirstSeenAt.Display</td>
            <td class="time">@client.LastSeenAt.Display</td>
            <td class="agent">@client.LastUserAgent</td>
        </tr>
    }
    @if (Model.Clients.Length == 0)
    {
        <tr>
            <td colspan="7" class="empty">No clients in this period.</td>
        </tr>
    }
    </tbody>
</table>
</div>

<nav class="pager">
    @if (Model.PageNumber > 0)
    {
        <a asp-page="/Clients" asp-route-Days="@Model.Days" asp-route-p="@(Model.PageNumber - 1)">← More recent</a>
    }
    <span>Page @(Model.PageNumber + 1) of @Model.PageCount</span>
    @if (Model.PageNumber + 1 < Model.PageCount)
    {
        <a asp-page="/Clients" asp-route-Days="@Model.Days" asp-route-p="@(Model.PageNumber + 1)">Older →</a>
    }
</nav>
