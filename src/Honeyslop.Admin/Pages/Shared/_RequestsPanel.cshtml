@model IRequestList

<div class="actions">
    <span class="count">@Model.TotalCount requests · live, updated @Model.RenderedAt.UtcDateTime.ToString("HH:mm:ss") UTC</span>
</div>

<div class="table-scroll">
<table class="entries">
    <thead>
    <tr>
        <partial name="_SortHeader" model='Model.Header(RequestColumn.Time, "Time")'/>
        <partial name="_SortHeader" model='Model.Header(RequestColumn.Client, "Client")'/>
        <partial name="_SortHeader" model='Model.Header(RequestColumn.Method, "Method")'/>
        <partial name="_SortHeader" model='Model.Header(RequestColumn.Host, "Host")'/>
        <partial name="_SortHeader" model='Model.Header(RequestColumn.Path, "Path")'/>
        <partial name="_SortHeader" model='Model.Header(RequestColumn.Outcome, "Outcome")'/>
        <partial name="_SortHeader" model='Model.Header(RequestColumn.Code, "Code", "number")'/>
        <partial name="_SortHeader" model='Model.Header(RequestColumn.Duration, "ms", "number")'/>
        <partial name="_SortHeader" model='Model.Header(RequestColumn.UserAgent, "User-Agent")'/>
    </tr>
    </thead>
    <tbody>
    @foreach (var request in Model.Requests)
    {
        <tr>
            <td class="time"><a asp-page="/Request" asp-route-id="@request.Id">@request.ReceivedAt.Display</a></td>
            <td class="mono"><partial name="_ClientIp" model="request.ClientIp"/></td>
            <td class="mono">@request.Method</td>
            <td class="mono host">@request.Host</td>
            <td class="mono target">
                @if (request.EntryId is { } entryId)
                {
                    <a asp-page="/Entry" asp-route-id="@entryId">@request.Target</a>
                }
                else
                {
                    @request.Target
                }
            </td>
            <td><span class="@request.Outcome.CssClass">@request.Outcome.ToString().ToLowerInvariant()</span></td>
            <td class="number mono">@request.ResponseStatus</td>
            <td class="number">@request.DurationMs</td>
            <td class="agent">@request.UserAgent</td>
        </tr>
    }
    @if (Model.Requests.Length == 0)
    {
        <tr>
            <td colspan="9" class="empty">No requests recorded yet.</td>
        </tr>
    }
    </tbody>
</table>
</div>

<nav class="pager">
    @if (Model.PageNumber > 0)
    {
        <a asp-page="@Model.ListPage" asp-all-route-data="Model.RouteValues(Model.PageNumber - 1)">@Model.PreviousLabel</a>
    }
    <span>Page @(Model.PageNumber + 1) of @Model.PageCount</span>
    @if (Model.PageNumber + 1 < Model.PageCount)
    {
        <a asp-page="@Model.ListPage" asp-all-route-data="Model.RouteValues(Model.PageNumber + 1)">@Model.NextLabel</a>
    }
</nav>
