@model ReportsTable

<div class="table-scroll">
    <table class="entries" data-sortable="@(Model.List is null ? "reports" : null)">
        <thead>
        <tr>
            @if (Model.List is { } list)
            {
                <partial name="_SortHeader" model='list.Header(ReportColumn.Requested, "Requested")'/>
                @if (Model.ShowClient)
                {
                    <partial name="_SortHeader" model='list.Header(ReportColumn.Client, "Client")'/>
                }
                @if (Model.ShowRequester)
                {
                    <partial name="_SortHeader" model='list.Header(ReportColumn.By, "By")'/>
                }
                <partial name="_SortHeader" model='list.Header(ReportColumn.To, "To")'/>
                <partial name="_SortHeader" model='list.Header(ReportColumn.Status, "Status")'/>
                <partial name="_SortHeader" model='list.Header(ReportColumn.Sent, "Sent")'/>
                <partial name="_SortHeader" model='list.Header(ReportColumn.Requests, "Requests", "number")'/>
                <partial name="_SortHeader" model='list.Header(ReportColumn.Attempts, "Attempts", "number")'/>
                <partial name="_SortHeader" model='list.Header(ReportColumn.Error, "Error")'/>
            }
            else
            {
                <th>Requested</th>
                @if (Model.ShowClient)
                {
                    <th>Client</th>
                }
                @if (Model.ShowRequester)
                {
                    <th>By</th>
                }
                <th>To</th>
                <th>Status</th>
                <th>Sent</th>
                <th class="number">Requests</th>
                <th class="number">Attempts</th>
                <th>Error</th>
            }
        </tr>
        </thead>
        <tbody>
        @foreach (var report in Model.Reports)
        {
            <tr>
                <td class="time"><a asp-page="/Report" asp-route-id="@report.Id">@report.CreatedAt.Display</a></td>
                @if (Model.ShowClient)
                {
                    <td class="mono"><partial name="_ClientIp" model="report.ClientIp"/></td>
                }
                @if (Model.ShowRequester)
                {
                    <td>@report.RequestedBy</td>
                }
                <td class="mono">@string.Join(", ", report.Recipients)</td>
                <td><span class="@report.CssClass">@report.Label</span></td>
                <td class="time">@report.SentAt.Display</td>
                <td class="number">@(report.AttachedRequests?.ToString() ?? "—")</td>
                <td class="number">@report.Attempts</td>
                <td class="error">@report.Error</td>
            </tr>
        }
        @if (Model.Reports.Length == 0)
        {
            <tr>
                <td colspan="@(6 + (Model.ShowClient ? 1 : 0) + (Model.ShowRequester ? 1 : 0))" class="empty">No abuse reports yet.</td>
            </tr>
        }
        </tbody>
    </table>
</div>
