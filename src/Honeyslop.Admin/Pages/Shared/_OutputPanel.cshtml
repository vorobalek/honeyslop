@model EntryModel
@if (Model.Output is not { } output)
{
    <p class="muted">Waiting for the first token…</p>
}
else
{
    <p class="muted">@output.Tokens @(output.Tokens == 1 ? "token" : "tokens") so far@(output.Truncated ? ", only the tail is shown" : "")</p>
    <pre class="code body">@(output.Truncated ? "…" : "")@output.Content</pre>
}
