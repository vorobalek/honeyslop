@using System.Globalization
@model GeneratorsModel

<section class="stats">
    <div class="stat"><span class="stat-value">@Model.Generators.Count(x => x.Status is not null)</span><span class="stat-label">generators up</span></div>
    <div class="stat"><span class="stat-value">@Model.BusySlots / @Model.TotalSlots</span><span class="stat-label">slots busy</span></div>
    <div class="stat"><span class="stat-value">@Model.Queue.Generating</span><span class="stat-label">generating</span></div>
    <div class="stat"><span class="stat-value">@Model.Queue.Queued</span><span class="stat-label">queued</span></div>
    <div class="stat"><span class="stat-value">@Model.Queue.Failed</span><span class="stat-label">failed</span></div>
</section>

<div class="actions">
    <span class="count">live, updated @Model.RenderedAt.UtcDateTime.ToString("HH:mm:ss") UTC · production figures cover the last 24 hours</span>
</div>

<div class="table-scroll">
<table class="entries">
    <thead>
    <tr>
        <th>Generator</th>
        <th>State</th>
        <th>Model</th>
        <th class="number">Slots</th>
        <th class="number">Prompt t/s</th>
        <th class="number">Gen t/s per slot</th>
        <th class="number">Deferred</th>
        <th class="number">Tokens out</th>
        <th class="number">Answers 24h</th>
        <th class="number">Avg time</th>
        <th class="number">Avg tokens</th>
        <th>Last answer</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var generator in Model.Generators)
    {
        var status = generator.Status;
        <tr>
            <td class="mono nowrap">
                @generator.Name
                @if (generator.Address is { } address && address != generator.Name)
                {
                    <span class="sub">@address</span>
                }
            </td>
            <td>
                @if (status is not null)
                {
                    <span class="badge @(status.BusySlots == status.Slots ? "badge-pending" : "badge-ready")">@(status.BusySlots == status.Slots ? "saturated" : "up")</span>
                }
                else if (generator.Discovered)
                {
                    <span class="badge badge-failed">unreachable</span>
                }
                else
                {
                    <span class="badge badge-static">gone</span>
                }
            </td>
            <td class="mono nowrap">
                @if (status is not null)
                {
                    @status.Model
                    var details = new[]
                    {
                        status.Parameters is { } parameters ? $"{(parameters / 1e9).ToString("0.0", CultureInfo.InvariantCulture)}B" : null,
                        status.SizeBytes is { } size ? $"{(size / 1024d / 1024d / 1024d).ToString("0.0", CultureInfo.InvariantCulture)} GB" : null
                    }.OfType<string>().ToArray();
                    @if (details.Length > 0)
                    {
                        <span class="sub">@string.Join(", ", details)</span>
                    }
                }
                else
                {
                    @:—
                }
            </td>
            <td class="number nowrap">
                @if (status is not null)
                {
                    <span class="slots">
                        @for (var slot = 0; slot < status.Slots; slot++)
                        {
                            <span class="slot @(slot < status.BusySlots ? "slot-busy" : "slot-idle")"></span>
                        }
                    </span>
                    @($"{status.BusySlots}/{status.Slots}")
                }
            </td>
            <td class="number">@(status?.PromptTokensPerSecond?.ToString("0.0", CultureInfo.InvariantCulture) ?? "—")</td>
            <td class="number">@(status?.PredictedTokensPerSecond?.ToString("0.0", CultureInfo.InvariantCulture) ?? "—")</td>
            <td class="number">@(status?.RequestsDeferred.ToString(CultureInfo.InvariantCulture) ?? "—")</td>
            <td class="number">@(status?.PredictedTokens.ToString("N0", CultureInfo.InvariantCulture) ?? "—")</td>
            <td class="number">@generator.Generated</td>
            <td class="number">@(generator.Generated > 0 ? (generator.AverageMs / 1000).ToString("0.0", CultureInfo.InvariantCulture) + " s" : "—")</td>
            <td class="number">@(generator.Generated > 0 ? generator.AverageTokens.ToString("0", CultureInfo.InvariantCulture) : "—")</td>
            <td class="time">@generator.LastGeneratedAt.Display</td>
        </tr>
    }
    @if (Model.Generators.Length == 0)
    {
        <tr>
            <td colspan="12" class="empty">No model servers found.</td>
        </tr>
    }
    </tbody>
</table>
</div>

<h2>Generating now</h2>
<div class="table-scroll">
<table class="entries">
    <thead>
    <tr>
        <th>Entry</th>
        <th>Method</th>
        <th>Host</th>
        <th>Path</th>
        <th>Generator</th>
        <th class="number">Attempt</th>
        <th class="number">Running for</th>
        <th class="number">Waited before</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var entry in Model.Generating)
    {
        <tr>
            <td><a asp-page="/Entry" asp-route-id="@entry.Id">@entry.Id</a></td>
            <td class="mono">@entry.Method</td>
            <td class="mono host">@entry.Host</td>
            <td class="mono target">@entry.Target</td>
            <td class="mono nowrap">
                @if (entry.Generator is { } generator)
                {
                    @generator
                }
                else
                {
                    <span class="muted">waiting for a slot</span>
                }
            </td>
            <td class="number">@(entry.Attempts + 1)</td>
            <td class="number">@((Model.RenderedAt - (entry.ClaimedAt ?? Model.RenderedAt)).DisplayDuration)</td>
            <td class="number">@(((entry.ClaimedAt ?? Model.RenderedAt) - entry.CreatedAt).DisplayDuration)</td>
        </tr>
    }
    @if (Model.Generating.Length == 0)
    {
        <tr>
            <td colspan="8" class="empty">Nothing is being generated.</td>
        </tr>
    }
    </tbody>
</table>
</div>

<h2>Queue · @Model.Queue.Queued waiting@(Model.Queue.OldestQueuedAt is { } oldest ? $", the oldest for {(Model.RenderedAt - oldest).DisplayDuration}" : "")</h2>
<p class="hint">Entries somebody asked for within the wait window go first, newest first; the rest are taken oldest first.</p>
<div class="table-scroll">
<table class="entries">
    <thead>
    <tr>
        <th>Entry</th>
        <th>Method</th>
        <th>Host</th>
        <th>Path</th>
        <th class="number">Queued for</th>
        <th class="number">Last requested</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var entry in Model.Queued)
    {
        <tr>
            <td><a asp-page="/Entry" asp-route-id="@entry.Id">@entry.Id</a></td>
            <td class="mono">@entry.Method</td>
            <td class="mono host">@entry.Host</td>
            <td class="mono target">@entry.Target</td>
            <td class="number">@((Model.RenderedAt - entry.CreatedAt).DisplayDuration)</td>
            <td class="number">@(entry.RequestedAt is { } requestedAt ? (Model.RenderedAt - requestedAt).DisplayDuration + " ago" : "—")</td>
        </tr>
    }
    @if (Model.Queued.Length == 0)
    {
        <tr>
            <td colspan="6" class="empty">The queue is empty.</td>
        </tr>
    }
    </tbody>
</table>
</div>
