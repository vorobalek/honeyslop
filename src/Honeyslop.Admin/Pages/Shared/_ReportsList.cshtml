@model ReportsModel

<div class="actions">
    <span class="count">@Model.TotalCount abuse reports, newest first</span>
</div>

<partial name="_ReportsTable" model="new ReportsTable(Model.Reports, true, User.CanOperate, Model)"/>

<nav class="pager">
    @if (Model.PageNumber > 0)
    {
        <a asp-page="/Reports" asp-all-route-data="Model.RouteValues(Model.PageNumber - 1)">@Model.PreviousLabel</a>
    }
    <span>Page @(Model.PageNumber + 1) of @Model.PageCount</span>
    @if (Model.PageNumber + 1 < Model.PageCount)
    {
        <a asp-page="/Reports" asp-all-route-data="Model.RouteValues(Model.PageNumber + 1)">@Model.NextLabel</a>
    }
</nav>
