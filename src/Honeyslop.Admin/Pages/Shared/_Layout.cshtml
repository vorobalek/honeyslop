<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="robots" content="noindex, nofollow"/>
    <title>@ViewData["Title"] · honeyslop</title>
    <link rel="stylesheet" href="~/site.css" asp-append-version="true"/>
    <script src="~/site.js" asp-append-version="true" defer></script>
</head>
<body>
<header class="topbar">
    <a class="brand" asp-page="/Index">honeyslop</a>
    <span class="subtitle">LLM honeypot</span>
    <span class="live-status" data-live-status>connecting…</span>
    <nav class="nav">
        <a asp-page="/Index">Entries</a>
        <a asp-page="/Requests">Requests</a>
        <a asp-page="/Clients">Clients</a>
        <a asp-page="/Generators">Generators</a>
        <a asp-page="/Settings">Settings</a>
    </nav>
</header>
<main class="container">
    @RenderBody()
</main>
</body>
</html>
