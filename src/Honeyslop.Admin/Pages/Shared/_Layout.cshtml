<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="robots" content="noindex, nofollow"/>
    <title>@ViewData["Title"] · honeyslop</title>
    <link rel="stylesheet" href="~/site.css" asp-append-version="true"/>
    <script src="~/site.js" asp-append-version="true" defer></script>
</head>
<body>
<header class="topbar">
    <a class="brand" asp-page="/Index">honeyslop</a>
    <span class="subtitle">LLM honeypot</span>
    <span class="live-status" data-live-status>connecting…</span>
    <nav class="nav">
        <a asp-page="/Index">Entries</a>
        <a asp-page="/Requests">Requests</a>
        <a asp-page="/Clients">Clients</a>
        <a asp-page="/Reports">Reports</a>
        <a asp-page="/Generators">Generators</a>
        <a asp-page="/Settings">Settings</a>
    </nav>
    @if (AppConfiguration.SignInEnabled)
    {
        if (User.Identity?.IsAuthenticated == true)
        {
            <form class="account" method="post" action="/signout" asp-antiforgery="true">
                <span class="account-name">@User.DisplayName</span>
                <button type="submit" class="link">Sign out</button>
            </form>
        }
        else
        {
            <span class="account">
                <span class="account-name">read-only</span>
                <a href="@Context.Request.SignInUrl">Sign in</a>
            </span>
        }
    }
</header>
<main class="container">
    @RenderBody()
</main>
<dialog class="confirm" data-confirm-dialog>
    <form method="dialog">
        <p class="confirm-question" data-confirm-question></p>
        <p class="hint" data-confirm-detail></p>
        <p class="hint" data-confirm-sender></p>
        <div class="actions">
            <button type="submit" value="cancel" autofocus>Cancel</button>
            <button type="submit" value="confirm" class="danger-filled" data-confirm-accept>Confirm</button>
        </div>
    </form>
</dialog>
<footer class="footer">
    <a href="https://db-ip.com" target="_blank" rel="noopener">IP Geolocation by DB-IP</a>
</footer>
</body>
</html>
