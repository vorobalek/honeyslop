@page "/reports/{id:long}"
@model ReportModel
@{
    var report = Model.Report;
    ViewData["Title"] = report.Subject;
}

<p class="back"><a asp-page="/Reports">← All reports</a> · <a asp-page="/Client" asp-route-ip="@report.ClientIp">everything about @report.ClientIp</a></p>

<h1 class="request-line">
    <span class="@report.State.CssClass">@report.State.Label</span>
    <span>@report.Subject</span>
</h1>

<dl class="meta">
    <dt>About</dt>
    <dd class="mono"><partial name="_ClientIp" model="new ClientIpLink(report.ClientIp, Model.Details.Country)"/></dd>
    <dt>To</dt>
    <dd class="mono">@string.Join(", ", report.Recipients)</dd>
    @if (User.CanOperate)
    {
        <dt>From</dt>
        @if (Model.Details.FromIsExpected)
        {
            <dd><span class="mono hint">@Model.Details.From</span> <span class="hint">· expected; fixed when the reporter sends it</span></dd>
        }
        else
        {
            <dd class="mono">@Model.Details.From</dd>
        }
    }
    <dt>Requested</dt>
    <dd>@report.CreatedAt.Display UTC@(User.CanOperate ? $" by {report.RequestedBy}" : "")</dd>
    <dt>Sent</dt>
    <dd>@(report.SentAt is { } sentAt ? $"{sentAt.Display} UTC" : "—")</dd>
    <dt>Attempts</dt>
    <dd>@report.Attempts</dd>
    <dt>Attachment</dt>
    <dd>@Model.Attachment</dd>
    <dt>Message-ID</dt>
    <dd class="mono">@(Model.Details.MessageId ?? "—")</dd>
    @if (!string.IsNullOrEmpty(report.Error))
    {
        <dt>Error</dt>
        <dd class="error">@report.Error</dd>
    }
</dl>

<h2>Letter</h2>
<pre class="code">@Model.Details.Body</pre>
