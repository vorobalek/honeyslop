@page
@model IndexModel
@{
    ViewData["Title"] = "Entries";
}

@if (Model.Expired is { } expired)
{
    <p class="notice">Expired @expired @(expired == 1 ? "entry" : "entries").</p>
}

<form class="filters" method="get" data-auto-filter>
    <label>Host <input type="search" name="Host" value="@Model.Host" placeholder="contains"/></label>
    <label>Path <input type="search" name="Target" value="@Model.Target" placeholder="contains"/></label>
    <label>
        State
        <select name="State">
            <option value="">any</option>
            @foreach (var state in Enum.GetValues<EntryState>())
            {
                <option value="@state" selected="@(Model.State == state)">@state.Label</option>
            }
        </select>
    </label>
    <label>
        Sort
        <select name="Sort">
            <option value="@EntrySort.Newest" selected="@(Model.Sort == EntrySort.Newest)">newest</option>
            <option value="@EntrySort.LastHit" selected="@(Model.Sort == EntrySort.LastHit)">last hit</option>
            <option value="@EntrySort.MostHits" selected="@(Model.Sort == EntrySort.MostHits)">most hits</option>
        </select>
    </label>
    <a class="button-link" asp-page="/Index">Reset</a>
</form>

<div data-live-panel data-live-topics="entries">
    <partial name="_EntriesPanel" model="Model"/>
</div>
