@page "/settings"
@model SettingsModel
@{
    ViewData["Title"] = "Settings";
}

<h1>Settings</h1>

@if (Model.Saved)
{
    <p class="notice">
        Saved and applied to everything already stored: expired @Model.Expired entries past their time to live and @Model.Unused unused ones, pruned @Model.Pruned request records, deleted @Model.Deleted expired entries no request refers to.
        Trap instances pick the change up within ten seconds and may serve an expired response from memory for up to a minute.
    </p>
}

@if (Model.PersonalSaved)
{
    <p class="notice">Saved your personal settings.</p>
}

@if (!User.CanOperate)
{
    <p class="notice">Read-only view. <a href="@Request.SignInUrl">Sign in</a> to change the settings.</p>
}

@if (User.UserId is not null)
{
    <form method="post" asp-page-handler="Personal">
    <fieldset class="settings">
        <h2>Personal <span class="hint">only for @User.DisplayName</span></h2>

        <div class="setting">
            <label asp-for="PersonalSenderName">Sign abuse reports as</label>
            <input asp-for="PersonalSenderName" type="text" maxlength="@SenderName.MaxLength" placeholder="@(Model.DefaultSenderName ?? "the address only")"/>
            <p class="hint">The sender name on the reports you send; it never goes into the letter itself. Empty uses @Model.DefaultSenderNameHint.</p>
        </div>

        <button type="submit">Save personal settings</button>
    </fieldset>
    </form>
}

<form method="post">
<fieldset class="settings" disabled="@(!User.CanOperate)">
    <h2>Cache</h2>

    <div class="setting">
        <label asp-for="CacheTtlValue">Expire generated responses after</label>
        <div class="duration">
            <input asp-for="CacheTtlValue" type="number" min="0" step="1"/>
            <select asp-for="CacheTtlUnit" asp-items="Html.GetEnumSelectList<SettingsModel.DurationUnit>()"></select>
        </div>
        <span asp-validation-for="CacheTtlValue" class="error"></span>
        <p class="hint">A response older than this expires and is generated again on the next request. 0 keeps responses forever.</p>
    </div>

    <div class="setting">
        <label asp-for="KeepUnusedValue">Expire entries nobody requested for</label>
        <div class="duration">
            <input asp-for="KeepUnusedValue" type="number" min="0" step="1"/>
            <select asp-for="KeepUnusedUnit" asp-items="Html.GetEnumSelectList<SettingsModel.DurationUnit>()"></select>
        </div>
        <span asp-validation-for="KeepUnusedValue" class="error"></span>
        <p class="hint">Counts from the last time the response was served, or from its creation if it never was. 0 keeps them forever.</p>
    </div>

    <h2>Generation</h2>

    <div class="setting">
        <label asp-for="GenerationWaitValue">Hold a request open for its new response up to</label>
        <div class="duration">
            <input asp-for="GenerationWaitValue" type="number" min="0" step="1"/>
            <select asp-for="GenerationWaitUnit" asp-items="Html.GetEnumSelectList<SettingsModel.DurationUnit>()"></select>
        </div>
        <span asp-validation-for="GenerationWaitValue" class="error"></span>
        <p class="hint">A client asking for a path nobody asked before waits this long for the model, then gets a plain 404 while the response keeps generating. Clients that give up earlier show up as abandoned.</p>
    </div>

    <h2>Timeouts</h2>

    <div class="setting">
        <label asp-for="TimeLimitValue">Give one generation at most</label>
        <div class="duration">
            <input asp-for="TimeLimitValue" type="number" min="0" step="1"/>
            <select asp-for="TimeLimitUnit" asp-items="Html.GetEnumSelectList<SettingsModel.DurationUnit>()"></select>
        </div>
        <span asp-validation-for="TimeLimitValue" class="error"></span>
        <p class="hint">Counted from the moment a model server slot takes the job, waiting for a free slot is not included. A generation that runs longer counts as a failed attempt.</p>
    </div>

    <div class="setting">
        <label asp-for="ClaimTimeoutValue">Treat a generation as abandoned after silence of</label>
        <div class="duration">
            <input asp-for="ClaimTimeoutValue" type="number" min="0" step="1"/>
            <select asp-for="ClaimTimeoutUnit" asp-items="Html.GetEnumSelectList<SettingsModel.DurationUnit>()"></select>
        </div>
        <span asp-validation-for="ClaimTimeoutValue" class="error"></span>
        <p class="hint">A trap instance working on an entry confirms it every quarter of this time. When the confirmations stop, because the instance died, another one takes the entry over.</p>
    </div>

    <div class="setting">
        <label asp-for="RetryFailedValue">Retry a failed generation after</label>
        <div class="duration">
            <input asp-for="RetryFailedValue" type="number" min="0" step="1"/>
            <select asp-for="RetryFailedUnit" asp-items="Html.GetEnumSelectList<SettingsModel.DurationUnit>()"></select>
        </div>
        <span asp-validation-for="RetryFailedValue" class="error"></span>
        <p class="hint">Only broken model output counts as a failure, up to three attempts per path. A model server that is down or restarting does not cost an attempt: the entry goes straight back to the queue.</p>
    </div>

    <h2>History</h2>

    <div class="setting">
        <label asp-for="RequestRetentionValue">Keep the request history for</label>
        <div class="duration">
            <input asp-for="RequestRetentionValue" type="number" min="0" step="1"/>
            <select asp-for="RequestRetentionUnit" asp-items="Html.GetEnumSelectList<SettingsModel.DurationUnit>()"></select>
        </div>
        <span asp-validation-for="RequestRetentionValue" class="error"></span>
        <p class="hint">Every request the trap answers is recorded with its headers and body. 0 keeps the history forever, which grows by roughly 2 GB a month at the current scanner traffic. An expired entry stays viewable while any recorded request refers to it.</p>
    </div>

    <div class="setting">
        <label class="checkbox"><input asp-for="AllowRefusals"/> Let the model refuse</label>
        <p class="hint">On: the model may answer with a login wall, 401, 403, a redirect or a 404 when that is what real software would do. Off: full anarchy, every path gets status 200 and invented content, and every login succeeds. Applies to new generations; expire everything to regenerate what is cached.</p>
    </div>

    <div class="setting">
        <label class="checkbox"><input asp-for="GenerationEnabled"/> Generate responses for new requests</label>
        <p class="hint">When off, cached responses are still served and every new path gets a plain 404 without touching the model.</p>
    </div>

    <h2>Access</h2>

    <div class="setting">
        <label class="checkbox"><input asp-for="PublicView"/> Show everything read-only without signing in</label>
        <p class="hint">
            On: anyone can open this admin without signing in and see all of it, the request history with headers, bodies and client addresses included. Saving settings and expiring entries still take signing in. Off: every page asks to sign in.
            @if (!AppConfiguration.SignInEnabled)
            {
                <text>Sign-in is not configured, so this has no effect: the admin relies on the proxy in front of it.</text>
            }
        </p>
    </div>

    <h2>Outbound requests</h2>

    <div class="setting">
        <label asp-for="UserAgent">User-Agent</label>
        <input asp-for="UserAgent" type="text" maxlength="@UserAgentHeader.MaxLength" placeholder="@Model.DefaultUserAgent"/>
        <span asp-validation-for="UserAgent" class="error"></span>
        <p class="hint">Sent with every WHOIS lookup at RIPEstat, so they know who asks and how to reach us. Empty uses "@Model.DefaultUserAgent" from the USER_AGENT variable.</p>
    </div>

    <button type="submit">Save</button>
</fieldset>
</form>
