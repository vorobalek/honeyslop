@page "/requests/{id:long}"
@model RequestModel
@{
    var record = Model.Record;
    ViewData["Title"] = $"{record.Method} {record.Host}{record.Target}";
}

<p class="back"><a asp-page="/Requests">← All requests</a> · <a asp-page="/Requests" asp-route-ClientIp="@record.ClientIp">everything from @record.ClientIp</a></p>

<h1 class="request-line">
    <span class="@record.Outcome.CssClass">@record.Outcome.ToString().ToLowerInvariant()</span>
    <span class="mono">@record.Method</span>
    <span class="mono host">@record.Host</span><span class="mono target">@record.Target</span>
</h1>

<dl class="meta">
    <dt>Received</dt>
    <dd>@record.ReceivedAt.Display UTC</dd>
    <dt>Client</dt>
    <dd class="mono"><a asp-page="/Requests" asp-route-ClientIp="@record.ClientIp">@record.ClientIp</a></dd>
    <dt>Response</dt>
    <dd class="mono">@record.ResponseStatus in @record.DurationMs ms</dd>
    <dt>Cache entry</dt>
    <dd>
        @if (record.EntryId is { } entryId)
        {
            <a asp-page="/Entry" asp-route-id="@entryId">entry @entryId</a>
        }
        else
        {
            @:—
        }
    </dd>
    <dt>Answered by</dt>
    <dd class="mono">@(record.Instance ?? "—")</dd>
</dl>

<h2>Request</h2>
<pre class="code">@record.Method @record.Target
@record.Headers
@record.Body</pre>
