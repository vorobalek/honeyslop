@page "/requests"
@model RequestsModel
@{
    ViewData["Title"] = "Requests";
}

<form class="filters" method="get" data-auto-filter>
    <label>Client IP <input type="search" name="ClientIp" value="@Model.ClientIp" placeholder="exact"/></label>
    <label>Host <input type="search" name="Host" value="@Model.Host" placeholder="contains"/></label>
    <label>Path <input type="search" name="Target" value="@Model.Target" placeholder="contains"/></label>
    <label>
        Outcome
        <select name="Outcome">
            <option value="">any</option>
            @foreach (var outcome in Enum.GetValues<RequestOutcome>())
            {
                <option value="@outcome" selected="@(Model.Outcome == outcome)">@outcome.ToString().ToLowerInvariant()</option>
            }
        </select>
    </label>
    @if (Model.EntryId is { } entryId)
    {
        <input type="hidden" name="EntryId" value="@entryId"/>
    }
    <a class="button-link" asp-page="/Requests">Reset</a>
</form>

@if (Model.EntryId is { } filteredEntryId)
{
    <p class="notice">Only requests answered with <a asp-page="/Entry" asp-route-id="@filteredEntryId">entry @filteredEntryId</a>.</p>
}

<div data-live-panel data-live-topics="requests">
    <partial name="_RequestsPanel" model="Model"/>
</div>
